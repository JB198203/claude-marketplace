      {
        "id": "fr-pas-juste",
        "regex": "(?i)\\bce n['’]est pas (?:juste|seulement|qu['’]une?) [^.!?\\n]{2,60}[,.] c['’]est\\b",
        "name": "« Ce n'est pas juste X, c'est Y »",
        "fix": "Dis la seule chose que tu veux dire. Supprime la mise en place."
      },
      {
        "id": "fr-non-seulement",
        "regex": "(?i)\\bnon seulement\\b[^.!?\\n]{2,80}\\bmais (?:aussi|également)\\b",
        "name": "« Non seulement X, mais aussi Y »",
        "fix": "Garde la moitié qui compte."
      },
      {
        "id": "fr-le-resultat",
        "regex": "(?im)^\\s*(?:le résultat|la raison|le secret|la clé|la vérité|le plus beau)\\s*\\?\\s*$",
        "name": "Question rhétorique d'un mot (« Le résultat ? »)",
        "fix": "Donne le résultat directement, sans suspense fabriqué."
      },
      {
        "id": "fr-et-si",
        "regex": "(?i)\\bet si je (?:te|vous) disais\\b",
        "name": "« Et si je vous disais… »",
        "fix": "Dis-le."
      },
      {
        "id": "fr-dans-cette-video",
        "regex": "(?i)\\b(?:dans (?:cette|la) vidéo|dans ce (?:reel|post)|je vais (?:te|vous) (?:montrer|expliquer|apprendre))\\b",
        "name": "Préambule de vidéo",
        "fix": "Supprime-le et commence par ce qui intéresse."
      },
