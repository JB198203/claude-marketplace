        "id": "fr-appat",
        "regex": "(?i)\\b(?:abonne[- ]toi pour|abonnez[- ]vous pour|identifie (?:quelqu['’]un|une personne|un ami|une amie|ta|ton)|tague (?:quelqu['’]un|un ami|une amie)|double[- ]tape|like si|partage si|commente si)\\b",
        "name": "Appât à abonnement ou identification",
        "fix": "Demande la seule action que ce post mérite."
      },
