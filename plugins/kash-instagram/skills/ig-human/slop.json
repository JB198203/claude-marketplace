        "id": "fr-conclusion",
        "regex": "(?im)^\\s*(?:en conclusion|pour conclure|en résumé|pour résumer)\\b",
        "name": "Conclusion de dissertation",
        "fix": "Coupe le résumé. Le lecteur vient de le lire."
      },
